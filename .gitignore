# ------------------------
# BACKEND (Python + FastAPI + Alembic)
# ------------------------

# Python cache & virtualenvs
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
Pipfile.lock
poetry.lock
dist/
build/

# Alembic / Migrations cache
backend/migrations/__pycache__/
backend/migrations/versions/*.pyc

# Environment & secrets
.env
backend/.env

# Logs
*.log

# Test cache & coverage
*.pytest_cache/
.coverage
htmlcov/

# Local database files (if using SQLite)
*.db
*.sqlite3

# Docker / Compose overrides
docker-compose.override.yml
.env.docker
.env.dev

# AWS credentials (safety)
.aws/

# Temporary files
*.pid
*.seed
tmp/

# ------------------------
# FRONTEND (Vite + React + Tailwind)
# ------------------------

# Node dependencies
frontend/node_modules/
frontend/.pnpm/
frontend/.npm/
frontend/.yarn/

# Build output
frontend/dist/
frontend/build/

# Cache
frontend/.cache/
frontend/.vite/
frontend/vite.config.ts.timestamp*
frontend/.parcel-cache/
frontend/.next/
frontend/out/

# Local environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ------------------------
# EDITOR & SYSTEM FILES
# ------------------------

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Swap files
*.swp

# Windows
Thumbs.db

